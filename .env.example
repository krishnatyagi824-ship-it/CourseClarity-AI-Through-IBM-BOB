# ============================================================
# CourseClarity AI — Local Development Configuration
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
#
# For deployment on Streamlit Community Cloud, add these
# variables via the platform's Secrets management UI instead
# of using a .env file.
# ============================================================

# IBM Cloud API Key
# Obtain from: IBM Cloud → Manage → Access (IAM) → API keys
IBM_API_KEY=your_ibm_api_key_here

# IBM watsonx.ai Project ID
# Obtain from: IBM watsonx.ai → Projects → your project → Manage → General
IBM_PROJECT_ID=your_project_id_here

# IBM Watson Machine Learning endpoint URL
# Use the URL for your region:
#   Dallas  : https://us-south.ml.cloud.ibm.com
#   London  : https://eu-gb.ml.cloud.ibm.com
#   Frankfurt: https://eu-de.ml.cloud.ibm.com
#   Sydney  : https://au-syd.ml.cloud.ibm.com
IBM_WML_URL=https://us-south.ml.cloud.ibm.com

# IBM Granite model ID
GRANITE_MODEL_ID=ibm/granite-4-h-small

# ── Generation parameters (optional — defaults shown) ────────────────────────
MAX_NEW_TOKENS=1024
TEMPERATURE=0.3
TOP_P=0.9
